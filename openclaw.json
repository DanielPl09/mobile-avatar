{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": {
        "primary": "huggingface/Qwen/Qwen3-235B-A22B-Instruct",
        "fallbacks": [
          "huggingface/deepseek-ai/DeepSeek-V3.2",
          "huggingface/moonshotai/Kimi-K2-Instruct"
        ]
      },
      "models": {
        "huggingface/Qwen/Qwen3-235B-A22B-Instruct": {
          "alias": "Qwen3 235B"
        },
        "huggingface/deepseek-ai/DeepSeek-V3.2": {
          "alias": "DeepSeek V3.2"
        },
        "huggingface/moonshotai/Kimi-K2-Instruct": {
          "alias": "Kimi K2"
        }
      }
    },
    "list": [
      {
        "id": "main",
        "identity": {
          "name": "OpenClaw",
          "emoji": "🦞",
          "theme": "helpful AI assistant"
        }
      }
    ]
  },

  "channels": {
    "telegram": {
      "enabled": true,

      "dmPolicy": "open",

      "groupPolicy": "open",

      "groups": {
        "*": {
          "requireMention": true
        }
      },

      "historyLimit": 50,
      "replyToMode": "first",
      "linkPreview": false,

      "customCommands": [
        { "command": "ask", "description": "Ask the AI a question" },
        { "command": "newchat", "description": "Start a fresh conversation" },
        { "command": "whichmodel", "description": "Show which AI model is active" },
        { "command": "about", "description": "About this bot" }
      ]
    }
  },

  "messages": {
    "visibleReplies": "automatic",
    "groupChat": {
      "historyLimit": 50,
      "unmentionedInbound": "room_event",
      "visibleReplies": "automatic"
    },
    "queue": {
      "mode": "followup",
      "debounceMs": 500,
      "byChannel": {
        "telegram": "followup"
      }
    }
  },

  "logging": {
    "level": "info",
    "file": "~/.openclaw/openclaw.log",
    "consoleLevel": "info",
    "consoleStyle": "pretty"
  },

  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token"
    }
  },

  "session": {
    "scope": "per-sender",
    "reset": {
      "mode": "daily",
      "atHour": 4
    },
    "resetTriggers": ["/new", "/reset"]
  }
}
