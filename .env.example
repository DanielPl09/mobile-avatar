# ─── Telegram ────────────────────────────────────────────────────────────────
# Your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ─── HuggingFace Inference ───────────────────────────────────────────────────
# Fine-grained token with "Make calls to Inference Providers" permission
# REQUIRED for the AI to respond — without this the bot accepts messages but can't reply
# Create one at: https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
HUGGINGFACE_HUB_TOKEN=hf_your_token_here

# ─── Gateway auth (auto-generated by setup.sh) ────────────────────────────────
# Local-only token for CLI <-> gateway auth. Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here
