# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Telegram group IDs the bot will respond in (comma-separated).
# Leave blank to allow any group.
ALLOWED_CHAT_IDS=-1001234567890

# How many message exchanges (user+bot pairs) to keep in context per topic
HISTORY_LIMIT=12

# Max tokens per bot reply
MAX_TOKENS=350

# ── Model selection ───────────────────────────────────────────────────────────
# Option A — DeepSeek API (recommended for cost < $0.5 / run, ~2 min runtime)
#   Get key at: https://platform.deepseek.com/api_keys
#   deepseek-chat = DeepSeek-V3 (Flash-class speed, $0.07-0.27/1M input tokens)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Option B — HuggingFace (fallback when DEEPSEEK_API_KEY is not set)
#   Get token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# SIM_MODEL  — used by simulate_patient.py for patient-turn generation
#   Cheap fast model is fine; patient messages are short and context-driven.
#   When using HF: Qwen/Qwen2.5-7B-Instruct (free tier, fast)
SIM_MODEL=Qwen/Qwen2.5-7B-Instruct

# JUDGE_MODEL — used by report_alignment.py / report_safety.py for LLM evaluation
#   Needs reasoning quality. When using HF: Qwen/Qwen2.5-72B-Instruct (Pro plan)
JUDGE_MODEL=Qwen/Qwen2.5-72B-Instruct

# Legacy fallback: both SIM_MODEL and JUDGE_MODEL default to this if not set above.
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# ── simulate_patient.py (Telethon user-account simulator) ────────────────────
# Get API_ID and API_HASH from https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here
PHONE=+972501234567
# Bot username to interact with (no @ needed)
SIMULATOR_BOT=vital_lifestyle_bot
# Max conversation turns before the simulator stops per session (default: 4)
# Keep at 4 to stay within the 2-3 min / $0.5 budget per full run.
SIMULATOR_MAX_TURNS=4
# How many messages to load as context for session N>1
SIMULATOR_CONTEXT_MESSAGES=6
# Seconds to wait between arc sessions (default: 3)
ARC_SESSION_DELAY=3

# ── Cost reference (DeepSeek deepseek-chat) ───────────────────────────────────
# Single-session run (all 3 personas, 4 turns each):
#   ~450 tokens simulation + ~12,000 tokens judge = ~$0.01
# Full arc run (Yotam 5 sessions + Tomer 3 sessions + Rina 1):
#   ~3,000 tokens simulation + ~35,000 tokens judge = ~$0.05
# Safety red-team (all 10 probes, 4 Tier-4 LLM calls):
#   ~8,000 tokens judge = ~$0.01
# Total (simulation + alignment + safety): well under $0.10 / full run

# ── Bot-to-bot back-and-forth ─────────────────────────────────────────────────
BOT_EXCHANGE_LIMIT=6
BOT_COOLDOWN=60
