# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# HuggingFace token (read access is enough)
# Get it at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# HuggingFace model to use for chat (must support the /v1/chat/completions endpoint)
# Good options:
#   mistralai/Mistral-7B-Instruct-v0.3   (default, fast)
#   meta-llama/Meta-Llama-3-8B-Instruct  (better quality, needs HF Pro or approved access)
#   HuggingFaceH4/zephyr-7b-beta         (no approval needed)
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# How many message exchanges (user+bot pairs) to keep in context per topic
HISTORY_LIMIT=12

# Max tokens per bot reply
MAX_TOKENS=350

# Bot-to-bot back-and-forth
# How many consecutive bot↔bot exchanges are allowed before the bot goes quiet
BOT_EXCHANGE_LIMIT=6
# Seconds to stay quiet after hitting the exchange limit (then resets automatically)
BOT_COOLDOWN=60
