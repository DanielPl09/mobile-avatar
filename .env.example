# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# HuggingFace token (read access is enough)
# Get it at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# HuggingFace model for chat responses (must support /v1/chat/completions)
# Default works on free HF accounts — no Pro subscription needed.
# Upgrade options (require HF Pro or approved access):
#   mistralai/Mistral-7B-Instruct-v0.3
#   meta-llama/Meta-Llama-3-8B-Instruct
HF_MODEL=HuggingFaceH4/zephyr-7b-beta

# Telegram group IDs the bot will respond in (comma-separated).
# Leave blank to allow any group.
# To find your group ID: add @userinfobot to the group and it will show the chat ID.
ALLOWED_CHAT_IDS=-1001234567890

# How many message exchanges (user+bot pairs) to keep in context per topic
HISTORY_LIMIT=12

# Max tokens per bot reply
MAX_TOKENS=350

# Bot-to-bot back-and-forth
# How many consecutive bot↔bot exchanges are allowed before the bot goes quiet
BOT_EXCHANGE_LIMIT=6
# Seconds to stay quiet after hitting the exchange limit (then resets automatically)
BOT_COOLDOWN=60
